# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Cloud SQL / PostgreSQL connection variables (Object Method)
SQL_HOST="localhost"
SQL_DB_NAME="smart_campus"
SQL_USER="smart_campus_app"
SQL_PASSWORD="change_me_app_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change_me_admin_password"
SQL_PORT="5432"

# Optional initial administrator email override
INITIAL_ADMIN_EMAIL=""

# Optional CORS allowed origin for exported deployments
CORS_ORIGIN="http://localhost:3000"
